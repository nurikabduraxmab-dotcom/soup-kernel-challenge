import os
import shutil

# 1. Переходим в корень репозитория
os.chdir('/kaggle/working/soup-kernel-challenge')

# 2. Создаем файл setup.py, регистрирующий оба имени (soup и soup_cli)
setup_content = """
from setuptools import setup, find_packages

setup(
    name="soup_cli",
    version="0.1",
    py_modules=["soup_cli"],
    packages=find_packages(),
)
"""

with open('setup.py', 'w') as f:
    f.write(setup_content)

# 3. Если папки soup_cli нет, создаем ссылку на soup
if os.path.exists('soup') and not os.path.exists('soup_cli'):
    try:
        os.symlink('soup', 'soup_cli')
    except Exception:
        shutil.copytree('soup', 'soup_cli')

