with open('/kaggle/working/soup-kernel-challenge/harness/_train.py', 'r') as f:
    code = f.read()

# main() функциясының ішін немесе model не trainer қалай жасалатынын іздейміз
for line in code.splitlines():
    if 'def main' in line or 'trainer' in line.lower() or 'model' in line.lower() or 'save' in line.lower():
        print(line[:100])


train_py_path = '/kaggle/working/soup-kernel-challenge/harness/_train.py'

with open(train_py_path, 'r') as f:
    content = f.read()

# Егер бұрын қосылмаған болса, адаптерді сақтайтын блокты өшіп қалмас үшін қосамыз
save_code = """
    # Адаптерді автоматты түрде сақтау (әділ тексеру үшін)
    try:
        if 'model' in locals() and hasattr(model, 'save_pretrained'):
            adapter_dir = os.path.dirname(args.metrics) + "/adapter"
            os.makedirs(adapter_dir, exist_ok=True)
            model.save_pretrained(adapter_dir)
    except Exception as e:
        pass

    write_json(args.metrics, metrics)
"""

if "adapter_dir = os.path.dirname(args.metrics)" not in content:
    # write_json(args.metrics, metrics) жолын біздің блокпен алмастырамыз
    new_content = content.replace("write_json(args.metrics, metrics)", save_code)
    with open(train_py_path, 'w') as f:
        f.write(new_content)
    print("harness/_train.py файлына адаптер сақтау коды сәтті қосылды!")
else:
    print("Адаптер сақтау коды бұрыннан бар.")


